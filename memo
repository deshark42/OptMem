def main():
    parser = argparse.ArgumentParser(description=__doc__.strip().format(memo=ME),
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--scope", choices=SCOPES)
    workspace_group = parser.add_mutually_exclusive_group()
    workspace_group.add_argument("--workspace")
    workspace_group.add_argument("--no-workspace", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("--memory-dir")
    parser.add_argument("--snapshot")
    parser.add_argument("command", choices=COMMANDS, nargs="?")
    parser.add_argument("args", nargs="*")
    opts = parser.parse_intermixed_args()
    if opts.command is None:
        parser.print_help()
        return
    root = None
    try:
        cmd = opts.command
        root = root_dir(opts.memory_dir)
        workspace = None if cmd == "init" or opts.no_workspace else workspace_path(opts.workspace)
        if opts.snapshot and cmd != "wake":
            die("--snapshot is only valid for wake.")
        if cmd == "init":
            if opts.scope or opts.args or opts.workspace:
                die("init initializes user/global only. Use memo init [--memory-dir PATH]; "
                    "use wake --workspace PATH to create a workspace.")
            with scope_context(root):
                init_scopes(root, persist=bool(opts.memory_dir))
            return
        require_root(root, workspace)
        if cmd == "config":
            if opts.scope:
                die("config applies to the centralized root; omit --scope.")
            with scope_context(root):
                cmd_config(root, opts.args, scoped=True)
            return
        config(root)
        validate_budget(WAKE_LINES)
        if cmd in ("note", "nap", "zoom", "forget", "import") and not opts.scope:
            die("%s requires --scope user|global|workspace; no default write scope." % cmd)
        selected = [opts.scope] if opts.scope else list(SCOPES)
        if cmd == "wake":
            scoped_wake(root, selected, workspace, opts.args, opts.snapshot)
            return
        stores = available_scopes(root, selected, workspace, reading=cmd == "recall")
        if cmd == "recall":
            scoped_recall(root, stores, workspace, opts.args)
        else:
            scope, path = stores[0]
            label = scope_label(scope, workspace)
            out = io.StringIO()
            try:
                with scope_context(root, scope, workspace), contextlib.redirect_stdout(out):
                    COMMANDS[cmd](path, opts.args)
            finally:
                print("[%s]" % label)
                print(scoped_text(out.getvalue(), label), end="")
    except OSError as e:
        die("%s: %s." % (pretty(e.filename or root or memory_dir()), e.strerror or e))


if __name__ == "__main__":
    main()
